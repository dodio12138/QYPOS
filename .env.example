POSTGRES_DB=qypos
POSTGRES_USER=qypos
POSTGRES_PASSWORD=qypos_password
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://qypos:qypos_password@postgres:5432/qypos
REDIS_URL=redis://redis:6379
API_PORT=4000
TZ=Europe/London
NEXT_PUBLIC_API_PORT=4000
NEXT_PUBLIC_API_URL=/api-proxy
# Optional WebSocket endpoint/base. If omitted, the frontend follows NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=
# Dedicated LAN WebSocket for the unpaired customer display. Leave blank to
# use ws(s)://<current-browser-host>:4000/ws/customer-display automatically.
NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_URL=
NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_PORT=4000
API_INTERNAL_URL=http://localhost:4000
PRINTER_DATABASE_URL=postgres://qypos:qypos_password@localhost:5433/qypos
PRINTER_REDIS_URL=redis://localhost:6379
PRINTER_DEFAULT_HOST=192.168.1.100
PRINTER_DEFAULT_PORT=9100
BACKUP_DIR=/app/backups
DOJO_API_KEY=
# Optional overrides. Sandbox keys automatically use softwareHouse1/reseller1.
DOJO_API_BASE_URL=https://api.dojo.tech
DOJO_API_VERSION=2026-02-27
DOJO_SOFTWARE_HOUSE_ID=
DOJO_RESELLER_ID=
# Online order connector (leave disabled until the QYLTPWeb POS endpoints are ready)
ONLINE_ORDER_BASE_URL=https://grannynoodles.co.uk
ONLINE_ORDER_SYNC_SECRET=replace_with_long_random_secret
ONLINE_ORDER_IMPORT_SECRET=replace_with_a_second_long_random_secret
ONLINE_ORDER_CONNECTOR_ID=restaurant-pos-1
ONLINE_ORDER_CURSOR=0
ONLINE_ORDER_ALLOW_INSECURE=false
ONLINE_ORDER_OPEN_TIME=11:00
ONLINE_ORDER_CLOSE_TIME=22:05
ONLINE_ORDER_TIME_ZONE=Europe/London
# Closed-hours check only; no SSE connection is kept outside the opening window.
ONLINE_ORDER_CLOSED_CHECK_MS=30000
