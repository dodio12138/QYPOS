FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY apps/web/package.json ./apps/web/package.json
RUN npm install --workspace @qypos/web --include-workspace-root
COPY apps/web ./apps/web
WORKDIR /app/apps/web
ARG NEXT_PUBLIC_API_URL=/api-proxy
ARG NEXT_PUBLIC_WS_URL=
ARG NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_URL=
ARG NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_PORT=4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_URL=$NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_URL
ENV NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_PORT=$NEXT_PUBLIC_CUSTOMER_DISPLAY_WS_PORT
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
